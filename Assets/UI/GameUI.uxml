            <ui:Image name="A-Button" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/A-Button(1).png?fileID=2800000&amp;guid=554d70511dec51f41a6264622532197b&amp;type=3#A-Button(1)&quot;); position: absolute; top: 0%; left: 100%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1;"/>
        </ui:Label>
        <ui:Label text="Throw" name="Throw" style="width: 10%; height: 50%; -unity-text-align: middle-center; align-self: auto; top: 25%; font-size: 100%; position: absolute; left: 50%; justify-content: flex-start; flex-direction: row; -unity-text-auto-size: best-fit 10px 1000px; -unity-text-generator: advanced; right: auto; -unity-font-style: bold; text-overflow: ellipsis;">
            <ui:Image name="Y-Button" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/Y-Button.png?fileID=2800000&amp;guid=5e6543a097b97ba4c82ee26f10cd7661&amp;type=3#Y-Button&quot;); position: absolute; top: 0%; left: 100%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1;"/>
        </ui:Label>
        <ui:Label text="Pick Up" name="Pick_Up" style="width: 10%; height: 50%; -unity-text-align: middle-center; align-self: auto; top: 25%; font-size: 100%; position: absolute; left: 70%; justify-content: flex-start; flex-direction: row; -unity-text-auto-size: best-fit 10px 1000px; -unity-text-generator: advanced; right: auto; -unity-font-style: bold; text-overflow: ellipsis;">
            <ui:Image name="X-Button" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/X-Button.png?fileID=2800000&amp;guid=e99b3cc8d242f554388c70b452f73aca&amp;type=3#X-Button&quot;); position: absolute; top: 0%; left: 100%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1;"/>
