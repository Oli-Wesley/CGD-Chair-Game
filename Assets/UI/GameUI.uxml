<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="ControlsBar" style="flex-grow: 1; position: absolute; height: 10%; top: 90%; width: 75%; left: 15%; border-left-color: rgba(255, 0, 0, 0); border-right-color: rgba(255, 0, 0, 0); border-top-color: rgba(255, 0, 0, 0); border-bottom-color: rgba(255, 0, 0, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; background-color: rgba(10, 122, 28, 0); flex-direction: row; right: auto; text-overflow: clip;">
        <ui:Label text="Dash" name="Dash" style="width: 10%; height: 50%; -unity-text-align: middle-center; align-self: auto; top: 25%; font-size: 20%; position: absolute; left: 30%; justify-content: flex-start; flex-direction: row; -unity-text-auto-size: best-fit 10px 1000px; -unity-text-generator: advanced; right: auto; -unity-font-style: bold; text-overflow: ellipsis; color: rgb(255, 255, 255);">
            <ui:Image name="A-Button" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/A-Button-White.png?fileID=2800000&amp;guid=0a746b8cbcdeb074bb7b7aa76e0dcf86&amp;type=3#A-Button-White&quot;); position: absolute; top: 0%; left: 100%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1; color: rgb(255, 255, 255);"/>
        </ui:Label>
        <ui:Label text="Throw" name="Throw" enabled="true" style="width: 10%; height: 50%; -unity-text-align: middle-center; align-self: auto; top: 25%; font-size: 20%; position: absolute; left: 70%; justify-content: flex-start; flex-direction: row; -unity-text-auto-size: best-fit 10px 1000px; -unity-text-generator: advanced; right: auto; -unity-font-style: bold; text-overflow: ellipsis; display: none; color: rgb(255, 255, 255);">
            <ui:Image name="Y-Button" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/Y-Button-White.png?fileID=2800000&amp;guid=ca42a37867180ac4abe393fbd3fa423e&amp;type=3#Y-Button-White&quot;); position: absolute; top: 0%; left: 100%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1; display: flex;"/>
        </ui:Label>
        <ui:Label text="Pick Up" name="Pick_Up" style="width: 10%; height: 50%; -unity-text-align: middle-center; align-self: auto; top: 25%; font-size: 20%; position: absolute; left: 50%; justify-content: flex-start; flex-direction: row; -unity-text-auto-size: best-fit 10px 1000px; -unity-text-generator: advanced; right: auto; -unity-font-style: bold; text-overflow: ellipsis; color: rgb(255, 255, 255); display: none;">
            <ui:Image name="X-Button" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/X-Button-White.png?fileID=2800000&amp;guid=c966fd507263060438067cb4d4298d3d&amp;type=3#X-Button-White&quot;); position: absolute; top: 0%; left: 120%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1;"/>
        </ui:Label>
        <ui:Label text="Move" name="Move" emoji-fallback-support="true" style="width: 10%; height: 50%; -unity-text-align: middle-center; align-self: auto; top: 25%; font-size: 20%; position: absolute; left: 10%; justify-content: flex-start; flex-direction: row; -unity-text-auto-size: best-fit 10px 1000px; -unity-text-generator: advanced; right: auto; -unity-font-style: bold; text-overflow: ellipsis; color: rgb(255, 255, 255);">
            <ui:Image name="R-Stick" style="width: auto; height: 100%; background-image: url(&quot;project://database/Assets/UI/Images%20and%20Icons/R-Stick-White.png?fileID=2800000&amp;guid=c407e56f91b53d8478e47003e8f1de1f&amp;type=3#R-Stick-White&quot;); position: absolute; top: 0%; left: 100%; bottom: auto; justify-content: center; align-items: center; align-self: center; align-content: center; aspect-ratio: 1;"/>
        </ui:Label>
    </ui:VisualElement>
    <ui:VisualElement name="PlayerBar" style="flex-grow: 1; top: 2%; left: 5%; right: 5%; width: 90%; height: 8%; position: absolute;">
        <ui:Label text="Player 1" name="Player1-Text" style="width: 25%; height: 30%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(184, 0, 0); top: 0; left: 0; position: absolute;">
            <ui:Label text="Score" name="Player1-Score-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(184, 0, 0); top: 90%; position: absolute; left: 0;"/>
            <ui:Label text="Inventory" name="Player1-Inventory-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(184, 0, 0); top: 210%; position: absolute; left: 0;"/>
        </ui:Label>
        <ui:Label text="Player 2" name="Player2-Text" style="width: 25%; height: 30%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(0, 103, 12); top: 0; left: 25%; position: absolute;">
            <ui:Label text="Score" name="Player1-Score-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(0, 103, 13); top: 90%; position: absolute; left: 0;"/>
            <ui:Label text="Inventory" name="Player1-Inventory-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(0, 103, 13); top: 210%; position: absolute; left: 0;"/>
        </ui:Label>
        <ui:Label text="Player 3" name="Player3-Text" style="width: 25%; height: 30%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(0, 1, 103); top: 0; left: 50%; position: absolute;">
            <ui:Label text="Score" name="Player1-Score-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(0, 1, 103); top: 90%; position: absolute; left: 0;"/>
            <ui:Label text="Inventory" name="Player1-Inventory-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(0, 1, 103); top: 210%; position: absolute; left: 0;"/>
        </ui:Label>
        <ui:Label text="Player 4" name="Player4-Text" style="width: 25%; height: 30%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(141, 66, 34); top: 0; left: 75%; position: absolute;">
            <ui:Label text="Score" name="Player1-Score-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(142, 66, 35); top: 90%; position: absolute; left: 0;"/>
            <ui:Label text="Inventory" name="Player1-Inventory-Text" style="width: 100%; height: 100%; -unity-text-align: middle-center; font-size: 15%; -unity-font-style: bold; color: rgb(142, 66, 35); top: 210%; position: absolute; left: 0;"/>
